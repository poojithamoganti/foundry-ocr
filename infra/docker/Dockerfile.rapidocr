# RapidOCR (ONNXRuntime) — CPU-only, no GPU needed, same as paddle-ocr.
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir rapidocr onnxruntime fastapi "uvicorn[standard]" pypdfium2

COPY services/rapid_ocr_service.py /app/rapid_ocr_service.py
WORKDIR /app

EXPOSE 8080
CMD ["uvicorn", "rapid_ocr_service:app", "--host", "0.0.0.0", "--port", "8080"]
